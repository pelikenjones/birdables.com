---
import Logo from '~/components/Logo.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import { getSiteSettings } from '~/lib/site';
import instagram from '~/assets/Instagram.svg?raw';
import twitter from '~/assets/Twitter.svg?raw';
import opensea from '~/assets/OpenSea.svg?raw';

const settings = await getSiteSettings();
const links = settings?.navLinks ?? [];
const socials = settings?.socialLinks ?? [];
const icons: Record<string, string> = { instagram, twitter, opensea };
const names: Record<string, string> = {
	instagram: 'Instagram',
	twitter: 'Twitter',
	opensea: 'OpenSea'
};
const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="mx-auto flex h-[5.5rem] w-full max-w-[90rem] items-center justify-between px-4 md:px-16">
	<div class="flex items-center gap-8 lg:gap-12">
		<a href="/" class="shrink-0" aria-label="Birdables home"><Logo /></a>
		<span class="hidden h-12 w-px bg-rule lg:block" aria-hidden="true"></span>

		<nav class="hidden items-center gap-8 md:flex" aria-label="Main">
		{
			links.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href!) ? 'page' : undefined}
					class="border-b-[3px] border-transparent pb-[5px] text-18 no-underline aria-[current=page]:border-beak-600"
				>
					{link.label}
				</a>
				))
			}
		</nav>
	</div>

	<div class="flex items-center gap-4 lg:gap-[1.375rem]">
		<ul class="hidden list-none items-center gap-5 p-0 lg:flex">
			{
				socials.map((social) => (
					<li>
						<a href={social.url} class="nav-social inline-flex" rel="me noopener" target="_blank">
							<span class="sr-only">{names[social.platform!] ?? social.platform}</span>
							<Fragment set:html={icons[social.platform!] ?? ''} />
						</a>
					</li>
				))
			}
		</ul>

		<ThemeToggle />

		<a
			href="/cards"
			class="hidden items-center rounded-full border border-gray-200 bg-surface px-[1.625rem] py-[0.8125rem] text-16 font-semibold no-underline md:inline-flex nav-cta"
		>
			Browse all cards
		</a>

		<button
			type="button"
			class="flex size-11 items-center justify-center rounded-full border border-rule md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			data-drawer-open
		>
			<span class="sr-only">Menu</span>
			<svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true">
				<path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="2"></path>
			</svg>
		</button>
	</div>
</header>

<!--
  <dialog> gives the drawer a real focus trap, Escape-to-close and inertness of
  the page behind it for free — none of which a div+ARIA drawer gets without
  a pile of JS.
-->
<dialog id="mobile-nav" class="drawer md:hidden" aria-label="Main">
	<div class="flex h-full flex-col gap-2 p-6">
		<button
			type="button"
			class="mb-6 self-end rounded-full border border-rule p-3"
			data-drawer-close
		>
			<span class="sr-only">Close menu</span>
			<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
				<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="2"></path>
			</svg>
		</button>
		{
			links.map((link) => (
				<a href={link.href} class="py-3 text-30 font-black tracking-tightest no-underline">
					{link.label}
				</a>
			))
		}
	</div>
</dialog>

<style>
	.nav-social :global(svg) {
		height: 1.25rem;
		width: auto;
		fill: currentColor;
	}
	/* Flat gray border in light, translucent white in dark — no single token. */
	:global([data-theme='dark']) .nav-cta {
		border-color: rgb(255 255 255 / 0.22);
		background: transparent;
	}

	.drawer {
		/* Edge-anchored, so it must not inherit the centred dialog margin. */
		margin: 0 0 0 auto;
		width: min(22rem, 85vw);
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0 0 0 auto;
		border: none;
		background: var(--surface);
		color: var(--ink);
		padding: 0;
	}
	.drawer::backdrop {
		background: rgb(12 18 23 / 0.5);
	}
</style>

<script>
	const dialog = document.getElementById('mobile-nav') as HTMLDialogElement | null;
	const trigger = document.querySelector<HTMLButtonElement>('[data-drawer-open]');

	if (dialog && trigger) {
		const sync = () => trigger.setAttribute('aria-expanded', String(dialog.open));

		trigger.addEventListener('click', () => {
			dialog.showModal();
			sync();
		});
		dialog.addEventListener('close', () => {
			sync();
			// Return focus to what opened it, which showModal() does not do.
			trigger.focus();
		});
		document
			.querySelector('[data-drawer-close]')
			?.addEventListener('click', () => dialog.close());

		// Clicking the backdrop closes it: the dialog element itself fills only
		// the drawer, so a click landing on it is a click outside the panel.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}
</script>
