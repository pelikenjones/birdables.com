---
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/ui/Button.astro';
import type { CardsQueryResult } from '~/lib/sanity.types';

/**
 * STATIC. The life list needs an eBird account link before it can mark
 * anything, so this ships as a demonstration and says so on its face rather
 * than implying a connection that is not there. Phase 6.
 */
interface Props {
	cards: CardsQueryResult;
}
const { cards } = Astro.props;

const grid = cards.slice(0, 20);
const SAMPLE_SEEN = new Set([0, 3, 4, 6, 9, 12, 13, 17, 19]);
const seenCount = SAMPLE_SEEN.size;
const pct = Math.round((seenCount / cards.length) * 100);
---

<div class="flex flex-col items-start gap-12 lg:flex-row lg:gap-[4.5rem]">
	<div class="w-full shrink-0 lg:w-[28.75rem]">
		<SectionHead
			num="06"
			kicker="Life list"
			title="Birdables Bingo."
			sub="Tick off the birds you have actually seen in the wild, not just the ones you own. Pull your life list from eBird and the card wall marks itself — the collection becomes a record of where you have been standing."
			id="bingo-heading"
		/>

		<div class="mt-9 flex flex-col gap-3.5 rounded-[1.25rem] border border-rule bg-panel px-6 py-[1.375rem]">
			<div class="flex items-baseline gap-2.5">
				<span class="text-38 font-black tracking-tightest text-accent-ink">{seenCount}</span>
				<span class="text-15 text-ink-dim">of {cards.length} spotted in the wild</span>
			</div>
			<div class="h-2.5 overflow-hidden rounded bg-rule" role="presentation">
				<div class="h-full rounded bg-beak-600" style={`width:${pct}%`}></div>
			</div>
			<span class="text-13 text-ink-faint">
				Sample progress — a real list would sync from eBird
			</span>
		</div>

		<div class="mt-7">
			<Button href="/about" variant="ghost">Connect eBird — coming soon</Button>
		</div>
	</div>

	<ul class="grid flex-1 list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3 lg:grid-cols-5">
		{
			grid.map((card, i) => {
				const got = SAMPLE_SEEN.has(i);
				return (
					<li
						class:list={[
							'relative flex h-[6.5rem] items-center justify-center rounded-2xl border p-2.5 text-center',
							got ? 'border-beak-600 bg-beak-600/10 text-ink' : 'border-rule text-ink-dim'
						]}
					>
						<span class="text-13 font-semibold leading-tight">{card.bird?.commonName}</span>
						{got && (
							<svg
								class="absolute right-2 top-2"
								width="15"
								height="15"
								viewBox="0 0 24 24"
								fill="none"
								aria-label="Spotted"
								role="img"
							>
								<path
									d="M4.5 12.5l5 5 10-11"
									stroke="var(--color-beak-600)"
									stroke-width="3"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						)}
					</li>
				);
			})
		}
	</ul>
</div>
