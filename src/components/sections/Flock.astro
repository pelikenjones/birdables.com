---
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/ui/Button.astro';
import StatTile from '~/components/ui/StatTile.astro';
import CardArt from '~/components/CardArt.astro';
import Stars from '~/components/ui/Stars.astro';
import { formatCount } from '~/lib/utils';
import type { CardsQueryResult } from '~/lib/sanity.types';

/**
 * Three featured cards rather than the whole wall.
 *
 * This used to print all 21 cards and then offer a button to a page showing the
 * same 21 — the section spent enormous height to say nothing /cards did not.
 * Picking three, each for a stated reason, gives the section its own argument
 * and leaves a reason to follow the link.
 */
interface Props {
	cards: CardsQueryResult;
}
const { cards } = Astro.props;

const scans = cards.reduce((sum, c) => sum + (c.qrScans ?? 0), 0);
const specialty = cards.filter((c) => c.specialty === 'specialty');
const atRisk = cards.filter(
	(c) => c.bird?.conservationStatus && c.bird.conservationStatus !== 'Least Concern'
);

const byRarity = [...cards].sort((a, b) => (b.rarity ?? 0) - (a.rarity ?? 0));
const byScans = [...cards].sort((a, b) => (b.qrScans ?? 0) - (a.qrScans ?? 0));

// Each pick earns its place, and none repeats.
const chosen: { card: (typeof cards)[number]; why: string }[] = [];
const add = (card: (typeof cards)[number] | undefined, why: string) => {
	if (card && !chosen.some((c) => c.card._id === card._id)) chosen.push({ card, why });
};
add(byRarity[0], 'Rarest of the flock');
add(byScans.find((c) => !chosen.some((x) => x.card._id === c._id)), 'Most scanned');
add(specialty.find((c) => !chosen.some((x) => x.card._id === c._id)), 'Specialty print');

const stats = [
	{ value: String(cards.length), label: 'cards in the flock' },
	{ value: formatCount(scans), label: 'QR scans across every card', accent: true },
	{ value: String(specialty.length), label: 'specialty cards with extra flourish' },
	{ value: String(atRisk.length), label: 'birds at some level of risk' }
];
---

<div class="flex flex-col gap-12">
	<div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
		<SectionHead
			num="04"
			kicker="The flock"
			title={`${cards.length === 21 ? 'Twenty-one' : cards.length} birds, so far.`}
			sub="Each one drawn from life, printed on recycled stock, and capped at however many its rarity allows."
			id="flock-heading"
		/>
		<Button href="/cards" variant="ghost">See all {cards.length}</Button>
	</div>

	<dl class="flex flex-col gap-5 sm:flex-row">
		{stats.map((s) => <StatTile value={s.value} label={s.label} accent={s.accent} />)}
	</dl>

	<ul class="grid list-none grid-cols-1 gap-8 p-0 sm:grid-cols-3" data-reveal="stagger">
		{
			chosen.map(({ card, why }) => (
				<li class="featured flex flex-col gap-4">
					<a href={`/bird/${card.bird?.slug}`} class="flex flex-col gap-4 no-underline">
						<span class="text-12 font-semibold uppercase tracking-eyebrow text-accent-ink">
							{why}
						</span>
						<div class="flex items-center justify-center rounded-3xl bg-panel px-6 py-9">
							{card.artwork?.asset && (
								<CardArt
									source={card.artwork.asset}
									alt={`${card.bird?.commonName} card`}
									width={380}
									aspectRatio={card.artwork.asset.aspectRatio}
									class="card-radius h-auto w-[72%] drop-shadow-card"
								/>
							)}
						</div>
						<div class="flex items-baseline justify-between gap-4">
							<span class="text-21 font-semibold tracking-[-0.015em]">
								{card.bird?.commonName}
							</span>
							<Stars value={card.rarity ?? 1} size={14} gap={2} />
						</div>
						<span class="text-15 text-ink-dim">{card.bird?.conservationStatus}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>

<style>
	.featured img {
		transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.featured a:hover img {
		transform: translateY(-10px) rotate(-1.5deg);
	}
	@media (prefers-reduced-motion: reduce) {
		.featured img {
			transition: none;
		}
	}
</style>
