---
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/ui/Button.astro';
import CardArt from '~/components/CardArt.astro';
import Stars from '~/components/ui/Stars.astro';
import type { CardsQueryResult } from '~/lib/sanity.types';

/**
 * PLACEHOLDER. This is the design-canvas section ported as drawn, wired to real
 * numbers but doing nothing — there is no scan flow behind it yet.
 *
 * The plan calls for rewriting this section entirely (a QR identifies a card
 * design and edition, not a physical copy, so nothing per-copy is possible).
 * That rewrite is deliberately deferred; when it happens, this component is
 * replaced rather than edited.
 *
 * Two deviations from the canvas, both standing corrections:
 *  - No "Hear its call" bar. There are no bird sounds, and a control that
 *    promises audio we will never have is worse than no control.
 *  - The kicker is "Scan", not "Scan · new idea" — that suffix was the design
 *    flagging its own inventions, not site copy.
 */
interface Props {
	cards: CardsQueryResult;
}

const { cards } = Astro.props;

const hero = cards.find((c) => c.slug === 'brown-pelican') ?? cards[0];
// Real aggregate rather than the canvas's placeholder 8,189.
const totalScans = cards.reduce((sum, c) => sum + (c.qrScans ?? 0), 0);
const scanLabel = new Intl.NumberFormat('en-US').format(totalScans);
---

<div class="flex flex-col items-center gap-16 lg:flex-row lg:gap-[5.25rem]">
	<div class="flex-1">
		<SectionHead
			num="05"
			kicker="Scan"
			title="Point your phone at the card. Meet the bird."
			sub="Every card already carries a QR code. It opens the bird's page — the range, the rarity, where to go and learn more."
			id="scan-heading"
		/>

		<div class="mt-9 inline-flex items-center gap-3.5 rounded-[1.125rem] border border-dashed border-beak-600 px-[1.375rem] py-4">
			<svg width="34" height="34" viewBox="0 0 9 9" aria-hidden="true" class="shrink-0">
				{
					[
						[0, 0, 3, 3], [4, 0, 1, 1], [6, 0, 3, 3], [5, 1, 1, 2], [0, 4, 1, 1],
						[2, 4, 2, 1], [5, 4, 1, 2], [7, 4, 2, 1], [4, 5, 1, 1], [0, 6, 3, 3],
						[4, 7, 2, 2], [7, 6, 1, 1], [8, 7, 1, 2], [6, 8, 1, 1]
					].map(([x, y, w, h]) => (
						<rect x={x} y={y} width={w} height={h} fill="var(--color-beak-600)" />
					))
				}
			</svg>
			<div class="flex flex-col gap-[3px]">
				<span class="text-14 font-semibold">{scanLabel} scans and counting</span>
				<span class="text-13 text-ink-faint">Every card in the wild, phoning home</span>
			</div>
		</div>

		<div class="mt-8">
			<Button href="/cards">Browse the flock</Button>
		</div>
	</div>

	<!-- Phone mock. Decorative: everything it shows is stated in the copy or
	     available on the card pages, so it is hidden from assistive tech. -->
	<div class="phone shrink-0" aria-hidden="true">
		<div class="phone-screen">
			{
				hero?.artwork?.asset && (
					<CardArt
						source={hero.artwork.asset}
						alt=""
						width={150}
						lqip={hero.artwork.asset.lqip}
						aspectRatio={hero.artwork.asset.aspectRatio}
						class="card-radius mx-auto h-auto w-[9.375rem] self-center drop-shadow-card"
					/>
				)
			}

			<div class="flex flex-col gap-0.5">
				<span class="text-15 text-ink-dim">{hero?.smallName}</span>
				<span class="text-30 font-black leading-none tracking-tightest">{hero?.bigName}</span>
				<span class="text-13 italic text-ink-faint">{hero?.bird?.scientificName}</span>
			</div>

			<dl class="flex flex-col gap-2.5">
				<div class="flex items-center justify-between border-t border-rule pt-2.5">
					<dt class="text-12 uppercase tracking-[0.08em] text-ink-faint">Rarity</dt>
					<dd><Stars value={hero?.rarity ?? 1} size={12} gap={2} /></dd>
				</div>
				<div class="flex items-center justify-between border-t border-rule pt-2.5">
					<dt class="text-12 uppercase tracking-[0.08em] text-ink-faint">Status</dt>
					<dd class="text-13 font-semibold">{hero?.bird?.conservationStatus}</dd>
				</div>
			</dl>
		</div>
	</div>
</div>

<style>
	.phone {
		position: relative;
		width: 18.75rem;
		border-radius: 2.625rem;
		background: var(--color-gray-900);
		padding: 0.875rem;
		box-shadow: 0 30px 60px rgb(17 25 30 / 0.45);
	}
	:global([data-theme='dark']) .phone {
		background: #05090b;
	}

	.phone-screen {
		display: flex;
		height: 37.75rem;
		flex-direction: column;
		gap: 1rem;
		overflow: hidden;
		border-radius: 1.875rem;
		background: #ffffff;
		padding: 1.75rem 1.375rem;
		/* The screen is always a light surface in light mode, so the tokens
		   inside it must not follow the page theme. */
		--surface: #ffffff;
		--ink: var(--color-gray-900);
		--ink-dim: var(--color-gray-500);
		--ink-faint: var(--color-gray-400);
		--rule: var(--color-gray-100);
		color: var(--ink);
	}
	:global([data-theme='dark']) .phone-screen {
		background: var(--color-gray-800);
		--surface: var(--color-gray-800);
		--ink: #ffffff;
		--ink-dim: var(--color-gray-300);
		--ink-faint: var(--color-gray-400);
		--rule: rgb(255 255 255 / 0.11);
	}
</style>
