---
import SectionHead from '~/components/SectionHead.astro';
import NotifyForm from '~/components/ui/NotifyForm.astro';
import { getSiteSettings } from '~/lib/site';

const settings = await getSiteSettings();
// No invented countdown: if no drop is scheduled, the clock simply isn't there.
const nextDropAt = settings?.nextDropAt ?? null;
---

<div class="flex flex-col items-start justify-between gap-12 lg:flex-row lg:items-center lg:gap-16">
	<div class="max-w-[35rem]">
		<SectionHead
			num="07"
			kicker="Next drop"
			title="Be the first to know when new Birdables hatch."
			sub="Card drops land in batches. Get the heads-up before the rarest tiers go."
			id="drop-heading"
		/>
	</div>

	<div class="flex w-full shrink-0 flex-col gap-[1.125rem] lg:w-auto">
		{
			nextDropAt && (
				<div class="flex items-center gap-3.5" data-countdown data-target={nextDropAt}>
					{['days', 'hours', 'mins'].map((unit) => (
						<div class="flex flex-col items-center gap-1.5">
							<span
								class="flex size-24 items-center justify-center rounded-3xl border border-rule bg-surface text-42 font-black tracking-tightest tabular-nums"
								data-unit={unit}
							>
								--
							</span>
							<span class="text-12 font-semibold uppercase tracking-eyebrow text-ink-faint">
								{unit}
							</span>
						</div>
					))}
				</div>
			)
		}

		<NotifyForm id="notify-drop" />
	</div>
</div>

<script>
	// Countdown, only rendered when a drop is actually scheduled.
	const clock = document.querySelector<HTMLElement>('[data-countdown]');
	if (clock) {
		const target = new Date(clock.dataset.target!).getTime();
		const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');

		const tick = () => {
			const ms = target - Date.now();
			const mins = Math.floor(ms / 60_000);
			const set = (unit: string, value: number) => {
				const el = clock.querySelector(`[data-unit="${unit}"]`);
				if (el) el.textContent = pad(value);
			};
			set('days', Math.floor(mins / 1440));
			set('hours', Math.floor((mins % 1440) / 60));
			set('mins', mins % 60);
			return ms > 0;
		};

		tick();
		const id = setInterval(() => {
			if (!tick()) clearInterval(id);
		}, 30_000);
	}
</script>
