---
import SectionHead from '~/components/SectionHead.astro';
import { getSiteSettings } from '~/lib/site';

const settings = await getSiteSettings();
const faqs = settings?.faqs ?? [];
---

<div class="flex flex-col items-start gap-12 lg:flex-row lg:gap-[4.5rem]">
	<div class="w-full shrink-0 lg:w-[26.25rem]">
		<SectionHead num="12" kicker="FAQ" title="The usual questions." id="faq-heading" />
	</div>

	<!--
	  <details> is the accordion. Keyboard support, screen-reader semantics and
	  find-in-page all work without a line of JS, which no div+ARIA version gets
	  for free. The first one is open, matching the canvas.
	-->
	<div class="flex-1 self-stretch">
		{
			faqs.map((faq, i) => (
				<details class="faq border-t border-rule" open={i === 0}>
					<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-[1.625rem]">
						<span class="text-18 font-semibold tracking-[-0.015em] sm:text-21">
							{faq.question}
						</span>
						<span class="mark inline-flex size-[2.125rem] shrink-0 items-center justify-center rounded-full border border-rule">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path
									class="v"
									d="M12 5v14"
									stroke="currentColor"
									stroke-width="2.2"
									stroke-linecap="round"
								/>
								<path d="M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
							</svg>
						</span>
					</summary>
					<p class="mb-[1.625rem] max-w-[41.25rem] text-16 leading-relaxed text-ink-dim">
						{faq.answer}
					</p>
				</details>
			))
		}
		<div class="border-t border-rule"></div>
	</div>
</div>

<style>
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq summary .mark {
		color: var(--ink-faint);
	}
	/* Open state: the plus loses its vertical stroke and the rule turns accent. */
	.faq[open] summary .mark {
		color: var(--accent-ink);
		border-color: var(--accent-ink);
	}
	.faq[open] summary .v {
		opacity: 0;
	}
	.faq summary .v {
		transition: opacity 120ms ease;
	}
</style>
