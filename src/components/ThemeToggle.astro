---
/**
 * Two-button segmented control. Both buttons stay in the tab order, so there is
 * no roving-tabindex state to get wrong; aria-pressed carries the current mode.
 */
const iconClass = 'pointer-events-none';
---

<div
	role="group"
	aria-label="Color theme"
	data-theme-toggle
	class="flex items-center gap-1 rounded-full border border-rule p-1"
>
	<button
		type="button"
		value="light"
		aria-pressed="true"
		class="flex size-[1.875rem] cursor-pointer items-center justify-center rounded-full text-ink-faint transition-colors hover:text-ink aria-pressed:bg-beak-600 aria-pressed:text-white aria-pressed:hover:text-white"
	>
		<svg
			width="15"
			height="15"
			viewBox="0 0 24 24"
			fill="none"
			aria-hidden="true"
			class={iconClass}
		>
			<circle cx="12" cy="12" r="4.4" stroke="currentColor" stroke-width="2"></circle>
			<path
				d="M12 1.6v2.6M12 19.8v2.6M22.4 12h-2.6M4.2 12H1.6M19.35 4.65l-1.84 1.84M6.49 17.51l-1.84 1.84M19.35 19.35l-1.84-1.84M6.49 6.49L4.65 4.65"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"></path>
		</svg>
		<span class="sr-only">Light</span>
	</button>

	<button
		type="button"
		value="dark"
		aria-pressed="false"
		class="flex size-[1.875rem] cursor-pointer items-center justify-center rounded-full text-ink-faint transition-colors hover:text-ink aria-pressed:bg-beak-600 aria-pressed:text-white aria-pressed:hover:text-white"
	>
		<svg
			width="15"
			height="15"
			viewBox="0 0 24 24"
			fill="none"
			aria-hidden="true"
			class={iconClass}
		>
			<path
				d="M20.5 14.2A8.6 8.6 0 019.8 3.5a8.6 8.6 0 1010.7 10.7z"
				stroke="currentColor"
				stroke-width="2"
				stroke-linejoin="round"></path>
		</svg>
		<span class="sr-only">Dark</span>
	</button>
</div>

<script>
	import { DEFAULT_THEME, STORAGE_KEY, type Theme } from '~/lib/theme';

	const read = (): Theme =>
		document.documentElement.dataset.theme === 'dark' ? 'dark' : DEFAULT_THEME;

	function apply(theme: Theme) {
		if (theme === DEFAULT_THEME) delete document.documentElement.dataset.theme;
		else document.documentElement.dataset.theme = theme;

		try {
			localStorage.setItem(STORAGE_KEY, theme);
		} catch {
			// Private mode / storage disabled — the choice just won't persist.
		}
		sync();
	}

	function sync() {
		const current = read();
		for (const group of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
			for (const button of group.querySelectorAll<HTMLButtonElement>('button[value]')) {
				button.setAttribute('aria-pressed', String(button.value === current));
			}
		}
	}

	document.addEventListener('click', (event) => {
		const button = (event.target as Element | null)?.closest<HTMLButtonElement>(
			'[data-theme-toggle] button[value]'
		);
		if (button) apply(button.value as Theme);
	});

	sync();
	document.addEventListener('astro:after-swap', sync);
</script>
