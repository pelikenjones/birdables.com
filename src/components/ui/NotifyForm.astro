---
/**
 * Drop-notification signup. Appears twice on the homepage — the drop band and
 * the footer — so the script binds by delegation and handles every instance.
 * A singular querySelector here was a real latent bug.
 */
interface Props {
	variant?: 'band' | 'compact';
	id: string;
	label?: string;
}
const { variant = 'band', id, label = 'Email address' } = Astro.props;
const compact = variant === 'compact';
---

<form class:list={['notify', compact && 'notify-compact']} data-notify-form novalidate>
	<label class="sr-only" for={id}>{label}</label>
	<input
		id={id}
		name="email"
		type="email"
		required
		autocomplete="email"
		placeholder={compact ? label : 'you@example.com'}
		class="notify-input"
	/>

	<!-- Honeypot: hidden from people and assistive tech; bots fill it. -->
	<div class="hidden" aria-hidden="true">
		<label for={`${id}-trap`}>Leave this empty</label>
		<input id={`${id}-trap`} name="trap" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<button type="submit" class="notify-submit">{compact ? 'Subscribe' : 'Notify me'}</button>
</form>

<p class="mt-2 text-13 text-ink-faint" data-notify-status role="status" aria-live="polite"></p>

<style>
	.notify {
		display: flex;
		width: 100%;
		flex-direction: column;
		gap: 0.75rem;
	}
	.notify-input {
		width: 100%;
		border-radius: 999px;
		border: 1px solid var(--rule);
		background: var(--surface);
		padding: 0.875rem 1.25rem;
		font: inherit;
		font-size: var(--text-15);
		color: var(--ink);
		outline: none;
	}
	.notify-input::placeholder {
		color: var(--ink-faint);
	}
	.notify-submit {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: var(--ink);
		color: var(--surface);
		padding: 0.875rem 1.625rem;
		font: inherit;
		font-size: var(--text-15);
		font-weight: 600;
		cursor: pointer;
	}
	.notify-submit:disabled {
		opacity: 0.6;
	}

	@media (min-width: 640px) {
		.notify {
			flex-direction: row;
			align-items: center;
			gap: 0.625rem;
			border-radius: 999px;
			border: 1px solid var(--rule);
			background: var(--surface);
			padding: 0.5rem 0.5rem 0.5rem 1.375rem;
		}
		.notify-input {
			border: 0;
			background: transparent;
			padding: 0;
		}
	}
	.notify-compact .notify-submit {
		padding: 0.6875rem 1.25rem;
		font-size: var(--text-14);
	}
	@media (min-width: 640px) {
		.notify-compact {
			padding: 0.375rem 0.375rem 0.375rem 1.125rem;
		}
	}
</style>

<script>
	// Delegated, so both the drop band and the footer form work.
	document.addEventListener('submit', async (event) => {
		const form = (event.target as Element).closest<HTMLFormElement>('[data-notify-form]');
		if (!form) return;
		event.preventDefault();

		const data = new FormData(form);
		const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
		const status = form.parentElement?.querySelector<HTMLElement>('[data-notify-status]');

		button.disabled = true;
		if (status) status.textContent = 'Signing you up…';

		try {
			const res = await fetch('/api/notify', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ email: data.get('email'), trap: data.get('trap') })
			});
			const body = await res.json();
			if (status) {
				status.textContent = res.ok
					? "You're on the list. Check your inbox to confirm."
					: (body.error ?? 'Something went wrong.');
			}
			if (res.ok) form.reset();
		} catch {
			if (status) status.textContent = 'Network hiccup. Try again?';
		} finally {
			button.disabled = false;
		}
	});
</script>
