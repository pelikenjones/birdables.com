---
interface Props {
	value: string;
	label: string;
	/** One tile per row may carry the accent. Orange is rationed. */
	accent?: boolean;
}
const { value, label, accent = false } = Astro.props;
---

<!--
  These live inside a <dl>, so they must be a dt/dd pair — a <dl> containing bare
  <div><span> children is invalid and axe flags it. Source order is dt then dd as
  the spec requires; column-reverse puts the value above the label visually.
-->
<div class="flex flex-1 flex-col-reverse gap-2 rounded-3xl bg-panel p-6">
	<dt class="text-14 leading-snug text-ink-dim">{label}</dt>
	<dd
		class:list={[
			'm-0 text-38 font-black leading-none tracking-tightest tabular-nums',
			accent && 'text-accent-ink'
		]}
	>
		{value}
	</dd>
</div>
