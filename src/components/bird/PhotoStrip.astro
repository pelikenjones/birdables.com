---
import CardArt from '~/components/CardArt.astro';
import type { BirdBySlugQueryResult } from '~/lib/sanity.types';

/**
 * Photographs borrowed from Wikimedia Commons.
 *
 * Every photo renders its photographer and exact licence underneath. That is a
 * condition of the licence, not styling — a photo without a visible credit is
 * an infringing use, so the caption is not optional and must not be truncated
 * away at small sizes.
 */
type Photos = NonNullable<NonNullable<BirdBySlugQueryResult>['photos']>;

interface Props {
	photos: Photos;
	name: string;
}
const { photos, name } = Astro.props;
---

<section aria-labelledby="photos-heading" class="flex flex-col gap-6">
	<div class="flex items-center gap-3">
		<span class="text-13 font-black tracking-eyebrow-wide text-accent-ink">02</span>
		<span class="h-0.5 w-[1.625rem] bg-beak-600" aria-hidden="true"></span>
		<h2 id="photos-heading" class="text-13 font-semibold uppercase tracking-eyebrow-wide text-ink-faint">
			In the wild
		</h2>
	</div>

	<ul class="grid list-none grid-cols-1 gap-[1.125rem] p-0 sm:grid-cols-3">
		{
			photos.map((photo, i) =>
				photo.image?.asset ? (
					<li class="flex flex-col gap-2.5">
						<figure class="m-0 flex flex-col gap-2.5">
							<button
								type="button"
								class="group relative block aspect-[4/3] overflow-hidden rounded-[1.375rem] bg-panel p-0"
								data-modal-open={`photo-${i}`}
							>
								<CardArt
									source={photo.image.asset}
									alt={photo.alt ?? `${name} photographed by ${photo.credit?.author}`}
									width={520}
									lqip={photo.image.asset.lqip}
									class="size-full object-cover"
								/>
								<span class="absolute bottom-3 right-3 flex size-8 items-center justify-center rounded-full bg-white/90 text-gray-900">
									<span class="sr-only">Expand</span>
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path
											d="M9 4H4v5M15 4h5v5M15 20h5v-5M9 20H4v-5"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
										/>
									</svg>
								</span>
							</button>
							<figcaption class="text-12 text-ink-faint">
								{photo.credit?.author} · {photo.credit?.license} ·{' '}
								<a href={photo.credit?.sourceUrl} rel="noopener" target="_blank" class="underline">
									Wikimedia Commons
								</a>
							</figcaption>
						</figure>
					</li>
				) : null
			)
		}
	</ul>

	{
		photos.map((photo, i) =>
			photo.image?.asset ? (
				<dialog id={`photo-${i}`} class="photo-modal animated" aria-label={`${name} photograph`}>
					<button type="button" class="photo-close" data-modal-close>
						<span class="sr-only">Close</span>
						<svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
							<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="2" />
						</svg>
					</button>
					<figure class="m-0 flex flex-col gap-3">
						<CardArt
							source={photo.image.asset}
							alt={photo.alt ?? `${name}`}
							width={1280}
							class="h-auto max-h-[80vh] w-full rounded-2xl object-contain"
						/>
						<figcaption class="text-13 text-white/70">
							{photo.credit?.author} · {photo.credit?.license} ·{' '}
							<a href={photo.credit?.sourceUrl} rel="noopener" target="_blank" class="underline">
								Wikimedia Commons
							</a>
						</figcaption>
					</figure>
				</dialog>
			) : null
		)
	}
</section>

<style>
	.photo-modal {
		width: min(72rem, 94vw);
		max-width: none;
		border: none;
		background: transparent;
		color: #ffffff;
		padding: 0;
		overflow: visible;
	}
	.photo-close {
		position: absolute;
		right: 0;
		top: -3rem;
		display: inline-flex;
		cursor: pointer;
		border: 0;
		background: none;
		color: #ffffff;
		padding: 0.5rem;
	}
</style>
