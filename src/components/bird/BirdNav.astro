---
interface Props {
	prev?: { commonName: string | null; slug: string | null };
	next?: { commonName: string | null; slug: string | null };
}
const { prev, next } = Astro.props;
---

<nav class="flex items-center justify-between gap-6 pb-[5.5rem] pt-8" aria-label="Other birds">
	{
		prev?.slug ? (
			<a href={`/bird/${prev.slug}`} data-astro-prefetch="load" class="flex flex-col gap-1 no-underline">
				<span class="text-12 font-semibold uppercase tracking-eyebrow text-ink-faint">Previous</span>
				<span class="text-21 font-semibold">{prev.commonName}</span>
			</a>
		) : (
			<span />
		)
	}

	<p class="hidden items-center gap-2.5 rounded-full bg-panel px-4 py-2.5 text-12 text-ink-faint md:flex">
		<kbd class="inline-flex size-[1.375rem] items-center justify-center rounded border border-gray-200 bg-surface">←</kbd>
		arrow keys move between birds
		<kbd class="inline-flex size-[1.375rem] items-center justify-center rounded border border-gray-200 bg-surface">→</kbd>
	</p>

	{
		next?.slug ? (
			<a href={`/bird/${next.slug}`} data-astro-prefetch="load" class="flex flex-col gap-1 text-right no-underline">
				<span class="text-12 font-semibold uppercase tracking-eyebrow text-ink-faint">Next</span>
				<span class="text-21 font-semibold">{next.commonName}</span>
			</a>
		) : (
			<span />
		)
	}
</nav>

<script define:vars={{ prevSlug: prev?.slug ?? null, nextSlug: next?.slug ?? null }}>
	// Ported from v1. Ignore when a modifier is held or focus is in a field, so
	// this never steals browser shortcuts or typing.
	document.addEventListener('keydown', (event) => {
		if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
		const el = document.activeElement;
		if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)) return;
		if (document.querySelector('dialog[open]')) return;

		if (event.key === 'ArrowLeft' && prevSlug) location.href = `/bird/${prevSlug}`;
		if (event.key === 'ArrowRight' && nextSlug) location.href = `/bird/${nextSlug}`;
	});
</script>
