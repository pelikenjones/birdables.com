---
import CardArt from '~/components/CardArt.astro';
import { urlFor } from '~/lib/image';
import type { SanityImageSource } from '@sanity/image-url';

/**
 * The card viewer, with a 2D / 3D toggle.
 *
 * 3D is three.js, chosen over a CSS-transform version for two things CSS cannot
 * do: real card THICKNESS with a visible paper edge, and rounded corners cut
 * into the geometry rather than baked into the artwork.
 *
 * It costs ~180kB gzipped, so it is behind a dynamic import fired on the FIRST
 * press of 3D and never before — anyone who stays in 2D downloads none of it.
 * The import is cached as a promise rather than a boolean, so two quick presses
 * share one download instead of starting two.
 *
 * The printed faces are deliberately UNLIT; see the material comment below.
 */
interface Props {
	source: SanityImageSource;
	alt: string;
	lqip?: string | null;
	aspectRatio?: number | null;
	/** Rendered height of the stage. The card page gives it more room. */
	size?: 'default' | 'large';
}
const { source, alt, lqip, aspectRatio, size = 'default' } = Astro.props;

const fullUrl = urlFor(source).width(1400).url();

// three loads the texture itself, so it needs a plain URL rather than markup.
const textureUrl = urlFor(source).width(760).url();
---

{
	/* On a large viewer 3D is the landing state, so the texture is needed almost
	   immediately. Its URL is known at build time, so the browser can start
	   fetching it during HTML parse rather than waiting for WebGL to ask. */
	size === 'large' && (
		<link rel="preload" as="image" href={textureUrl} fetchpriority="high" crossorigin />
	)
}

<div
	class:list={['viewer', size === 'large' && 'viewer-large']}
	data-card-viewer-three
	data-texture={textureUrl}
>
	<div class="stage" data-stage>
		<button type="button" class="flat" data-flat data-modal-open="card-full">
			<span class="sr-only">View {alt} full size</span>
			<CardArt
				source={source}
				alt={alt}
				width={520}
				lqip={lqip}
				aspectRatio={aspectRatio}
				loading="eager"
				fetchpriority="high"
				class="card-radius h-auto w-full drop-shadow-card"
			/>
		</button>
		<canvas class="canvas" data-canvas hidden aria-label={alt}></canvas>
		<p class="loading" data-loading hidden>Loading 3D…</p>

		<div class="zoom" data-zoom hidden>
			<button type="button" data-zoom-out disabled>
				<span class="sr-only">Zoom out</span>
				<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
				</svg>
			</button>
			<button type="button" data-zoom-in>
				<span class="sr-only">Zoom in</span>
				<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>

		<div class="toggle" role="group" aria-label="Card view">
			<button type="button" value="2d" aria-pressed={size !== 'large'}>2D</button>
			<button type="button" value="3d" aria-pressed={size === 'large'}>3D</button>
		</div>
	</div>

	<p class="hint" data-hint>
		<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path d="M9 6l-3 6 3 6M15 6l3 6-3 6" stroke="currentColor" stroke-width="2"
				stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
		Drag to turn · scroll or use + / − to zoom
	</p>
	<dialog id="card-full" class="card-modal animated" aria-label={alt}>
		<button type="button" class="card-close" data-modal-close>
			<span class="sr-only">Close</span>
			<svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
				<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="2"></path>
			</svg>
		</button>
		<img src={fullUrl} alt={alt} class="card-radius h-auto max-h-[86vh] w-auto" />
	</dialog>
</div>

<style>
	.card-modal {
		width: auto;
		max-width: 94vw;
		border: none;
		background: transparent;
		padding: 0;
		overflow: visible;
		color: #ffffff;
	}
	.card-close {
		position: absolute;
		right: 0;
		top: -3rem;
		display: inline-flex;
		border: 0;
		background: none;
		color: #ffffff;
		padding: 0.5rem;
	}

	/* How much of the panel's height the card occupies. The 3D camera reads this
	   so both modes present the card at identical scale — one source of truth
	   instead of a number duplicated in CSS and in the camera maths. */
	.viewer { --card-fill: 0.79; position: relative; display: flex; flex-direction: column; align-items: center; gap: 1.125rem; }
	.stage {
		position: relative; display: flex; width: 100%; align-items: center; justify-content: center;
		border-radius: 2.5rem; height: 34rem;
		/* The canvas fills the panel, so clipping follows this radius instead of
		   the canvas's own rectangle. Without it a zoomed card is cut off square
		   inside a rounded box. */
		overflow: hidden;
		background-color: var(--color-gray-blue);
		background-image: radial-gradient(var(--color-gray-300) 1.2px, transparent 1.2px);
		background-size: 22px 22px;
	}
	:global([data-theme='dark']) .stage {
		background-color: transparent; border: 1px solid var(--rule);
		background-image: radial-gradient(circle at 50% 42%, rgb(211 225 228 / 0.18), rgb(17 25 30 / 0) 64%);
	}
	/* Sized by height so 2D and 3D present the card at the same scale and the
	   panel does not resize when you toggle. */
	.flat {
		height: 27rem;
		border: 0;
		padding: 0;
		background: none;
		transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.flat :global(img) { height: 100%; width: auto; }
	.viewer:not([data-mode='3d']) .flat:hover { transform: translateY(-6px) scale(1.015); }

	/* The card page gives the artwork real presence — it is the focal point. */
	.viewer-large { --card-fill: 0.86; }
	.viewer-large .stage { height: 54rem; }
	.viewer-large .flat { height: 46.4rem; }
	@media (max-width: 1280px) {
		.viewer-large .stage { height: 44rem; }
		.viewer-large .flat { height: 37.8rem; }
	}
	@media (max-width: 1024px) {
		.viewer-large { --card-fill: 0.79; }
		.viewer-large .stage { height: 34rem; }
		.viewer-large .flat { height: 27rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.flat { transition: none; }
		.viewer:not([data-mode='3d']) .flat:hover { transform: none; }
	}

	.canvas {
		position: absolute; inset: 0; width: 100%; height: 100%;
		display: block; touch-action: none; cursor: grab;
	}
	.canvas:active { cursor: grabbing; }
	.loading {
		position: absolute; inset: auto auto 4.5rem 50%; translate: -50% 0;
		font-size: var(--text-13); color: var(--ink-dim);
	}
	.toggle {
		position: absolute; left: 50%; bottom: 1.25rem; translate: -50% 0; z-index: 1;
		display: flex; align-items: center; gap: 0.25rem; padding: 0.25rem;
		border-radius: 999px; background: #ffffff; box-shadow: var(--shadow-pop);
	}
	.toggle button {
		border: 0; cursor: pointer; border-radius: 999px; padding: 0.5rem 1.125rem;
		font: inherit; font-size: var(--text-13); font-weight: 600;
		background: transparent; color: var(--color-gray-500);
	}
	.toggle button[aria-pressed='true'] { background: var(--color-gray-900); color: #ffffff; }
	/* Always present, so entering 3D does not change the component's height. */
	.hint {
		display: inline-flex; align-items: center; gap: 0.5rem;
		font-size: var(--text-13); color: var(--ink-faint);
		visibility: hidden;
	}
	.viewer[data-mode='3d'] .hint { visibility: visible; }

	.zoom {
		position: absolute; right: 1.5rem; top: 1.5rem;
		display: flex; flex-direction: column; gap: 0.25rem; padding: 0.25rem;
		border-radius: 999px; background: #ffffff; box-shadow: var(--shadow-pop);
	}
	.zoom button {
		display: inline-flex; align-items: center; justify-content: center;
		width: 2rem; height: 2rem; border: 0; cursor: pointer; border-radius: 999px;
		background: transparent; color: var(--color-gray-900);
	}
	.zoom button:disabled { opacity: 0.32; cursor: default; }
</style>

<script>
	// Type-only: erased at build, so this does NOT pull three into the page.
	// The real import is the dynamic one inside boot().
	import type * as THREE from 'three';

	const viewer = document.querySelector<HTMLElement>('[data-card-viewer-three]');
	const stage = viewer?.querySelector<HTMLElement>('[data-stage]');
	const flat = viewer?.querySelector<HTMLElement>('[data-flat]');
	const canvas = viewer?.querySelector<HTMLCanvasElement>('[data-canvas]');
	const hint = viewer?.querySelector<HTMLElement>('[data-hint]');
	const loading = viewer?.querySelector<HTMLElement>('[data-loading]');
	const zoom = viewer?.querySelector<HTMLElement>('[data-zoom]');
	const zoomIn = viewer?.querySelector<HTMLButtonElement>('[data-zoom-in]');
	const zoomOut = viewer?.querySelector<HTMLButtonElement>('[data-zoom-out]');

	if (viewer && stage && flat && canvas && hint && loading && zoom && zoomIn && zoomOut) {
		// Cached as a PROMISE, not a boolean — two fast clicks must not start
		// two downloads, and the second caller should await the first's result.
		let scenePromise: Promise<{ dispose: () => void; replay: () => void }> | null = null;

		// The library download is kept separate from building the scene, so it can
		// begin before anything else is ready. When 3D is the landing state the
		// old arrangement was the worst of both: still a runtime fetch, but not
		// started until setMode had run its async chain.
		let threePromise: Promise<typeof import('three')> | null = null;
		const loadThree = () => (threePromise ??= import('three'));


		/** Genuine absence of WebGL, as opposed to anything else going wrong. */
		function webglMissing() {
			try {
				const probe = document.createElement('canvas');
				return !(probe.getContext('webgl2') ?? probe.getContext('webgl'));
			} catch {
				return true;
			}
		}

		async function boot() {
			const THREE = await loadThree();

			const renderer = new THREE.WebGLRenderer({ canvas: canvas!, antialias: true, alpha: true });
			renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
			// Neutral pass-through: no filmic curve to shift the artwork's colour.
			renderer.toneMapping = THREE.NoToneMapping;
			renderer.outputColorSpace = THREE.SRGBColorSpace;

			const scene = new THREE.Scene();
			const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
			camera.position.set(0, 0, 14);

			// Drive size from the canvas's real box so it tracks the panel at any
			// viewport width, rather than a number baked in at boot.
			const resize = () => {
				const w = canvas!.clientWidth || 1;
				const h = canvas!.clientHeight || 1;
				renderer.setSize(w, h, false);
				camera.aspect = w / h;
				camera.updateProjectionMatrix();
			};
			resize();
			const ro = new ResizeObserver(resize);
			ro.observe(canvas!);

			// A card is 2.5 × 3.5 inches with rounded corners. Thickness and the
			// corner radius are the whole reason to be in WebGL, so both are
			// modelled rather than faked.
			const card = new THREE.Group();
			const W = 5, H = 7, D = 0.05, R = 0.28;

			const rounded = new THREE.Shape();
			rounded.moveTo(-W / 2 + R, -H / 2);
			rounded.lineTo(W / 2 - R, -H / 2);
			rounded.quadraticCurveTo(W / 2, -H / 2, W / 2, -H / 2 + R);
			rounded.lineTo(W / 2, H / 2 - R);
			rounded.quadraticCurveTo(W / 2, H / 2, W / 2 - R, H / 2);
			rounded.lineTo(-W / 2 + R, H / 2);
			rounded.quadraticCurveTo(-W / 2, H / 2, -W / 2, H / 2 - R);
			rounded.lineTo(-W / 2, -H / 2 + R);
			rounded.quadraticCurveTo(-W / 2, -H / 2, -W / 2 + R, -H / 2);

			/** Shape/Extrude geometries UV-map from shape coordinates, which would
			 *  stretch the artwork. Remap from the card's own bounds instead. */
			const fitUVs = (geometry: THREE.BufferGeometry) => {
				const pos = geometry.attributes.position;
				const uv = geometry.attributes.uv;
				for (let i = 0; i < pos.count; i++) {
					uv.setXY(i, (pos.getX(i) + W / 2) / W, (pos.getY(i) + H / 2) / H);
				}
				uv.needsUpdate = true;
			};

			const loader = new THREE.TextureLoader();
			loader.setCrossOrigin('anonymous');

			const load = async (url: string, what: string) => {
				try {
					return await loader.loadAsync(url);
				} catch {
					throw new Error(
						`Could not load the ${what} texture. If this is a cdn.sanity.io URL, add this ` +
							`origin (${location.origin}) to the project's CORS allow-list.`
					);
				}
			};

			const front = await load(viewer!.dataset.texture!, 'card front');
			// The 2x back: this texture is zoomable, so resolution earns its 117kB.
			const back = await load('/images/cards/card-back@2x.webp', 'card back');
			for (const t of [front, back]) {
				t.colorSpace = THREE.SRGBColorSpace;
				t.anisotropy = renderer.capabilities.getMaxAnisotropy();
			}

			// The printed faces are UNLIT, deliberately.
			//
			// The artwork is already a finished, correctly-exposed image. A lit
			// material renders as albedo × incident light, so there is no light
			// level that returns the original: too little and it goes muddy, too
			// much and the highlights clip and it goes chalky. Both were tried.
			//
			// MeshBasicMaterial samples the texture and nothing else, so the face
			// is pixel-identical to the 2D view. The three-dimensionality comes
			// from geometry — perspective, rounded corners and the lit paper edge —
			// which is what was actually wanted from WebGL. Galleries light flat
			// artwork evenly for the same reason.
			const paperFace = (map: THREE.Texture) => new THREE.MeshBasicMaterial({ map });

			const faceGeo = new THREE.ShapeGeometry(rounded, 24);
			fitUVs(faceGeo);

			// Sit the printed faces very slightly PROUD of the extruded body.
			// At exactly ±D/2 they are coplanar with the body's end caps, and the
			// two surfaces z-fight — which renders as the body's paper colour
			// punching through the artwork in patches.
			const SKIN = 0.0016;

			const frontFace = new THREE.Mesh(faceGeo, paperFace(front));
			frontFace.position.z = D / 2 + SKIN;

			const backFace = new THREE.Mesh(faceGeo.clone(), paperFace(back));
			backFace.position.z = -D / 2 - SKIN;
			backFace.rotation.y = Math.PI;

			// The body supplies the visible paper edge between the two faces.
			const bodyGeo = new THREE.ExtrudeGeometry(rounded, {
				depth: D - SKIN,
				bevelEnabled: false,
				curveSegments: 24
			});
			bodyGeo.translate(0, 0, -(D - SKIN) / 2);
			const body = new THREE.Mesh(
				bodyGeo,
				new THREE.MeshPhysicalMaterial({ color: 0xf6f3ec, roughness: 0.95, metalness: 0 })
			);

			card.add(body, frontFace, backFace);
			scene.add(card);

			// Lighting now only reaches the extruded body, i.e. the paper edge.
			// That is the one surface where shading carries information — it is how
			// you read the card's thickness as it turns.
			scene.add(new THREE.AmbientLight(0xffffff, 1.6));
			const key = new THREE.DirectionalLight(0xffffff, 1.1);
			key.position.set(-3, 5, 9);
			scene.add(key);
			const fill = new THREE.DirectionalLight(0xffffff, 0.5);
			fill.position.set(5, -2, 6);
			scene.add(fill);

			const REST_Y = -0.25, REST_X = 0.08;
			let ry = REST_Y, rx = REST_X, dragging = false, last = { x: 0, y: 0 };
			let frame = 0, alive = true;

			// The card is 7 units tall; --card-fill says what fraction of the panel
			// height the 2D view gives it. Solving for the camera distance that
			// frames the same fraction is what stops the card resizing on toggle.
			const cardFill =
				parseFloat(getComputedStyle(viewer!).getPropertyValue('--card-fill')) || 0.79;
			const FAR = 7 / cardFill / (2 * Math.tan((32 * Math.PI) / 360));
			const NEAR = FAR * 0.55;
			let dist = FAR, targetDist = FAR;

			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const SPIN_MS = 1800;
			let spinStart = 0;

			/** Full turn, decelerating into the resting tilt. */
			const playIntro = () => {
				if (reduced) {
					card.rotation.set(REST_X, REST_Y, 0);
					ry = REST_Y;
					rx = REST_X;
					return;
				}
				card.rotation.set(REST_X, 0, 0);
				spinStart = performance.now();
			};

			const render = () => {
				frame = 0;

				if (spinStart) {
					const t = Math.min(1, (performance.now() - spinStart) / SPIN_MS);
					const eased = 1 - Math.pow(1 - t, 3);
					// Starts face-on, matching 2D exactly, then turns all the way
					// round so the back and the paper edge both get seen.
					card.rotation.y = eased * (Math.PI * 2 + REST_Y);
					if (t === 1) {
						spinStart = 0;
						ry = REST_Y;
						card.rotation.y = REST_Y;
					}
				} else {
					card.rotation.y += (ry - card.rotation.y) * 0.085;
					card.rotation.x += (rx - card.rotation.x) * 0.085;
				}

				dist += (targetDist - dist) * 0.085;
				camera.position.z = dist;
				renderer.render(scene, camera);
				if (alive) frame = requestAnimationFrame(render);
			};
			playIntro();
			render();

			const zoomTo = (v: number) => {
				targetDist = Math.max(NEAR, Math.min(FAR, v));
				zoomIn!.disabled = targetDist <= NEAR + 0.01;
				zoomOut!.disabled = targetDist >= FAR - 0.01;
			};
			const onZoomIn = () => zoomTo(targetDist - 1.6);
			const onZoomOut = () => zoomTo(targetDist + 1.6);
			zoomIn!.addEventListener('click', onZoomIn);
			zoomOut!.addEventListener('click', onZoomOut);

			// Only swallow the wheel while actually zooming, so the page still
			// scrolls once the card is at either limit.
			const wheel = (e: WheelEvent) => {
				const next = Math.max(NEAR, Math.min(FAR, targetDist + e.deltaY * 0.01));
				if (next !== targetDist) {
					e.preventDefault();
					zoomTo(next);
				}
			};
			canvas!.addEventListener('wheel', wheel, { passive: false });

			const down = (e: PointerEvent) => {
				// Grabbing it mid-spin should hand control over immediately.
				if (spinStart) {
					spinStart = 0;
					ry = card.rotation.y;
				}
				dragging = true; last = { x: e.clientX, y: e.clientY };
				canvas!.setPointerCapture(e.pointerId);
			};
			const move = (e: PointerEvent) => {
				if (!dragging) return;
				ry += (e.clientX - last.x) * 0.011;
				rx = Math.max(-0.7, Math.min(0.7, rx + (e.clientY - last.y) * 0.008));
				last = { x: e.clientX, y: e.clientY };
			};
			const up = (e: PointerEvent) => {
				if (!dragging) return;
				dragging = false;
				canvas!.releasePointerCapture(e.pointerId);
				ry = Math.round(ry / Math.PI) * Math.PI;
				rx = 0;
			};
			canvas!.addEventListener('pointerdown', down);
			canvas!.addEventListener('pointermove', move);
			canvas!.addEventListener('pointerup', up);
			canvas!.addEventListener('pointercancel', up);

			return {
				replay: playIntro,
				dispose() {
					alive = false;
					if (frame) cancelAnimationFrame(frame);
					canvas!.removeEventListener('pointerdown', down);
					canvas!.removeEventListener('pointermove', move);
					canvas!.removeEventListener('pointerup', up);
					canvas!.removeEventListener('pointercancel', up);
					canvas!.removeEventListener('wheel', wheel);
					ro.disconnect();
					zoomIn!.removeEventListener('click', onZoomIn);
					zoomOut!.removeEventListener('click', onZoomOut);
					for (const m of [frontFace, backFace, body]) {
						m.geometry.dispose();
						(m.material as THREE.Material).dispose();
					}
					front.dispose();
					back.dispose();
					renderer.dispose();
				}
			};
		}

		async function setMode(mode: string) {
			for (const b of viewer!.querySelectorAll<HTMLButtonElement>('.toggle button')) {
				b.setAttribute('aria-pressed', String(b.value === mode));
			}
			viewer!.dataset.mode = mode;

			if (mode === '3d') {
				loading!.hidden = false;
				try {
					const first = !scenePromise;
					scenePromise ??= boot();
					const scene = await scenePromise;
					flat!.hidden = true;
					canvas!.hidden = false;
					zoom!.hidden = false;
					// Re-entering 3D replays the turn rather than snapping to rest.
					if (!first) scene.replay();
				} catch (e) {
					// Say what actually went wrong. Blaming the browser for what is
					// usually a CORS setting sends people to debug the wrong thing.
					console.error('[card viewer] 3D failed:', e);
					hint!.textContent = webglMissing()
						? 'This browser has WebGL disabled, so 3D is unavailable.'
						: (e as Error).message || 'Could not start 3D — see the console.';
					scenePromise = null;
				} finally {
					loading!.hidden = true;
				}
			} else {
				canvas!.hidden = true;
				zoom!.hidden = true;
				flat!.hidden = false;
			}
		}

		viewer.querySelector('.toggle')?.addEventListener('click', (event) => {
			const button = (event.target as Element).closest<HTMLButtonElement>('button[value]');
			if (button) void setMode(button.value);
		});

		// ── initial mode ──────────────────────────────────────────────────────
		// This was missing entirely, which is why 3D never started on its own:
		// the toggle was wired up and the library was fetched, but nothing ever
		// built the scene.
		const large = viewer.classList.contains('viewer-large');

		if (!large) {
			void setMode('2d');
		} else {
			// 3D is the landing state here, but three is ~180kB and the card is
			// already on screen in 2D — so it waits for the page's own resources
			// to finish rather than competing with them. The swap is invisible
			// apart from the card becoming interactive.
			const start = () => void setMode('3d');
			const whenIdle = () =>
				'requestIdleCallback' in window
					? requestIdleCallback(start, { timeout: 2000 })
					: setTimeout(start, 200);

			if (document.readyState === 'complete') whenIdle();
			else window.addEventListener('load', whenIdle, { once: true });
		}
	}
</script>
