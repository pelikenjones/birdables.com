{
	"name": "birdables",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"typegen": "pnpm --filter birdables-studio typegen",
		"studio": "pnpm --filter birdables-studio dev",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@astrojs/vercel": "^11.0.10",
		"@portabletext/markdown": "^2.2.0",
		"@sanity/astro": "^3.2.10",
		"@sanity/client": "^7.26.2",
		"@sanity/image-url": "^2.1.1",
		"astro": "^7.3.2",
		"groq": "^6.14.0",
		"posthog-js": "^1.413.3",
		"resend": "^6.28.1",
		"sharp": "^0.35.4",
		"three": "^0.186.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/sitemap": "^3.7.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/three": "^0.186.0",
		"prettier": "~3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.1"
	},
	"pnpm": {
		"peerDependencyRules": {
			"ignoreMissing": [
				"react",
				"react-dom",
				"react-is",
				"sanity",
				"styled-components"
			]
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		]
	}
}
