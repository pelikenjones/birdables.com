# ─────────────────────────────────────────────────────────────────────────────
# Env scheme: ONE file, at the repo root, and ONE prefix.
#
#   PUBLIC_*  is read by the Astro app — via loadEnv() in astro.config.mjs
#             (which runs before Astro loads .env) and import.meta.env.PUBLIC_*
#             everywhere else. It ships to the browser. Never put a token here.
#
#   Anything without the prefix is server-side only: the /api routes and the
#   scripts in scripts/, run from this directory with `node --env-file=.env`.
#
# The Studio does NOT read this file. Its project id and dataset are public
# identifiers and live in studio/sanity.project.ts, which is where Sanity's CLI
# expects them. See the comment in that file for why.
#
# The Studio has two env vars of its own, in studio/.env — Sanity's bundler only
# reads .env from the Studio's directory and only exposes SANITY_STUDIO_*. See
# studio/.env.example. One of them must match MEDIA_FETCH_SECRET below.
# ─────────────────────────────────────────────────────────────────────────────

# `ubrw2onn` is the PROJECT id. `onAnzpJce` is the ORGANIZATION id and 404s.
PUBLIC_SANITY_PROJECT_ID="ubrw2onn"
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_API_VERSION="2026-09-15"

# Editor token. NOT used by the build — the static build reads published content
# over the CDN, unauthenticated — but it IS a runtime dependency of all three
# server routes via src/lib/server/sanityWrite.ts, plus every script in scripts/.
#
# So it must be set on Vercel. Without it writeClient is null and /api/vote,
# /api/notify and /api/fetch-media each answer 503 rather than throwing.
SANITY_WRITE_TOKEN=""

# ── Resend ───────────────────────────────────────────────────────────────────
# Owns the drop-notification list: storage, double opt-in, unsubscribe, sending.
# Sanity keeps a read-only mirror so signups are visible in the Studio.
# Server-side only — read by src/pages/api/notify.ts.
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""

# ── Borrowed media ────────────────────────────────────────────────────────────
# LEAVE THIS EMPTY. It is the one var here where filling it in is the wrong move.
#
# Audio comes from Wikimedia Commons, which mirrors a large slice of xeno-canto's
# CC BY-SA recordings and whose reuse and User-Agent terms are public and have
# been read. Reusing a recording is governed by the recordist's CC licence and
# that part is settled either way.
#
# Querying xeno-canto's OWN API may not be: their terms are reported to grant
# unlimited access for NON-COMMERCIAL use, and Birdables sells cards. Their terms
# page is behind bot protection and has never been read. Ask them directly before
# setting this. See the box comment in src/lib/server/media.ts.
#
# With no key, findAudio() is never called and nothing is requested or stored;
# /api/fetch-media uses the Commons path only.
XENO_CANTO_API_KEY=""

# Shared secret guarding /api/fetch-media so it is not an open upload endpoint.
# Any long random string. SANITY_STUDIO_MEDIA_SECRET in studio/.env must hold the
# SAME VALUE — set only one of the pair and the button answers 401.
MEDIA_FETCH_SECRET=""

# PostHog. Proxied through /ingest by vercel.json so it's a first-party request.
PUBLIC_POSTHOG_KEY=""
